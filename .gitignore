# ==========================================
# Nexgen Hackathon - .gitignore
# ==========================================


# ------------------------------------------
# 1. Environment Variables / API Keys
# ------------------------------------------

.env
.env.*
!.env.example
!.env.*.example

*.pem
*.key


# ------------------------------------------
# 2. Python
# ------------------------------------------

__pycache__/
*.py[cod]
*$py.class

.venv/
venv/
env/

.pytest_cache/
.mypy_cache/
.ruff_cache/

.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

*.egg-info/
dist/
build/


# ------------------------------------------
# 3. JavaScript / TypeScript / Node.js
# ------------------------------------------

node_modules/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.next/
.nuxt/
.svelte-kit/

.vite/
.turbo/
.pnpm-store/
*.tsbuildinfo
coverage/


# ------------------------------------------
# 4. IDE / Editors
# ------------------------------------------

.idea/

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json


# ------------------------------------------
# 5. Operating System
# ------------------------------------------

.DS_Store
._*
Thumbs.db
Desktop.ini


# ------------------------------------------
# 6. Temporary Files
# ------------------------------------------

*.tmp
*.temp
*.swp
*.swo

*.bak
*.log

.cache/
tmp/
temp/


# ------------------------------------------
# 7. Local Databases
# ------------------------------------------

*.sqlite
*.sqlite3
*.db
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.db-journal
*.db-wal
*.db-shm


# ------------------------------------------
# 8. Local Secrets / Credentials
# ------------------------------------------

secrets/
credentials/

service-account*.json

# Generated demo activity; keep the shared JSON fixtures tracked.
/data/activity.json
/data/local/


# ------------------------------------------
# 9. Optional Local References
# ------------------------------------------

# Uncomment if you have local-only reference files:
# Conferences/
# references/

# Local backend plans, task briefs, and stage summaries.
/backend/docs/
